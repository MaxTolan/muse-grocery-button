# Grocery button settings, loaded after the SDK's overlays for the 1.75C
# (tools/fw.sh passes it to board.sh with MUSE_EXTRA_DEFAULTS).

# The grocery screen, voice loop and voice inbox (components/grocery_button).
CONFIG_GROCERY_BUTTON=y

# For now a press goes to Muse as a voice note and Muse's reply shows as text.
# The Google speech path (on-device transcription and spoken script) is parked
# in issue #1.
# CONFIG_GROCERY_GOOGLE_SPEECH is not set

# A plain text message sent just ahead of each voice note (SDK patch 0005).
# Muse rebuilds a voice note's own text from its transcript, so the source
# tag can't ride on the note; this message carries it instead. It starts with
# the tag, "[fridge-button] " (issue #2, grocery_source.h; the build fails
# without it), and says what the note is for. No double quotes.
CONFIG_MUSE_VOICE_NOTE_PRELUDE="[fridge-button] Voice note from the grocery button on my refrigerator follows: a grocery item for my Costco or Kroger list. Please reply in one short sentence."

# The status screen's title size, on top of the SDK's 14/16/20/28.
CONFIG_LV_FONT_MONTSERRAT_40=y

# Google speech only: the speaker amp's enable (the BSP's BSP_POWER_AMP_IO),
# held low through deep sleep so the amp stays off. GPIO46 is a strapping pin
# whose safe level is low.
CONFIG_GROCERY_AMP_GPIO=46

# Waking from deep sleep is a full boot, and the owner is already talking:
# skip the 8 MB PSRAM test and the app image check on that path.
# CONFIG_SPIRAM_MEMTEST is not set
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# Google's APIs are reached over plain HTTPS with the certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
